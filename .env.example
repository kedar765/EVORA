# ==============================================================================
# EVORA Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL / Local Fallback)
# ------------------------------------------------------------------------------
# Supabase Direct Connection (Session Mode):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Transaction Pooler (Recommended for Serverless / Port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Environment Mode: 'development' or 'production'
# In 'production', DATABASE_URL is mandatory. Local SQLite fallback is disabled.
ENVIRONMENT=development

# Connection Pooling Configuration
EVORA_DB_POOL_MIN=1
EVORA_DB_POOL_MAX=10
EVORA_DB_POOL_TIMEOUT=30.0

# Optional Local SQLite Database Path (Used only when DATABASE_URL is unset in development)
EVORA_DB_PATH=backend/evora.db

# ------------------------------------------------------------------------------
# 2. Security & Session Configuration
# ------------------------------------------------------------------------------
# Set to 'true' in production with HTTPS
EVORA_COOKIE_SECURE=false

# Trusted CORS & CSRF origins (comma-separated)
EVORA_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. AI Agent & LLM Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
ANALYTICS_GEMINI_MODEL=gemini-2.5-flash
RISK_GEMINI_MODEL=gemini-2.5-flash
DECISION_GEMINI_MODEL=gemini-2.5-flash

# Groq LLM Fallback (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
